<configuration>
  <!-- 禁用客户端/代理缓存：返回 Cache-Control: no-cache -->
  <system.webServer>
    <staticContent>
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>
    <!-- 禁用IIS输出缓存（用户模式） -->
    <caching enabled="false" />
    <!-- 可选：禁用内核模式缓存（站点级） -->
    <httpCompression>
      <dynamicTypes>
        <clear />
      </dynamicTypes>
      <staticTypes>
        <clear />
      </staticTypes>
    </httpCompression>
        <httpProtocol allowKeepAlive="false" />
  </system.webServer>
  <!-- 动态页面（ASP.NET）额外防护 -->
  <system.web>
    <caching>
      <outputCache enableOutputCache="false" />
    </caching>
  </system.web>
</configuration>